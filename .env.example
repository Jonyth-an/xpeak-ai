# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Dictionary APIs (Optional - for fallback)
OXFORD_API_KEY=your_oxford_api_key
OXFORD_APP_ID=your_oxford_app_id
WORDNIK_API_KEY=your_wordnik_api_key
URBAN_DICTIONARY_API_KEY=your_urban_dictionary_api_key
FREEDICTIONARY_API_KEY=your_freedictionary_api_key
WORDNET_API_KEY=your_wordnet_api_key
DATAMUSE_API_KEY=your_datamuse_api_key
TWINWORD_API_KEY=your_twinword_api_key

# Application Configuration
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Database Configuration (if using external database)
DATABASE_URL=your_database_url

# Email Configuration (if using external email service)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Storage Configuration (if using external storage)
STORAGE_BUCKET=your_storage_bucket
STORAGE_REGION=your_storage_region
